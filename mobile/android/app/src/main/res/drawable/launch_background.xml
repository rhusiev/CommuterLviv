<?xml version="1.0" encoding="utf-8"?>
<!-- What Android draws between tapping the icon and Flutter's first frame.
     The same plate and mark as the launcher icon, so the two are continuous.
     `gravity="center"` and no size: a window background is stretched to fill,
     and a bitmap drawn that way would come out distorted on every aspect
     ratio but one. The bitmap comes from tool/icons.sh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash" />
    </item>
</layer-list>
