# Copy to `.env` and fill in. Compose reads it; nothing else does.
# `.env` is gitignored - keep it that way.

# The database. The password is never typed again after this file, so make it
# long: `openssl rand -base64 24`
POSTGRES_USER=commuterlviv
POSTGRES_PASSWORD=change_me
POSTGRES_DB=commuterlviv

# The exact origins allowed to make unsafe requests, comma separated. Scheme,
# host and port, no trailing slash - `https://commuterlviv.r1a.nl`. The phone app
# has no web origin and sends `app://commuterlviv`; drop it if you do not use it.
COMMUTERLVIV_ORIGINS=https://commuterlviv.r1a.nl,app://commuterlviv

# Where the app is served, for the invite links `admin invite` prints. Defaults
# to the first origin above, which is usually right.
#COMMUTERLVIV_WEB_BASE=https://commuterlviv.r1a.nl

# open | code | closed. `code` means an invite link is needed to register.
#COMMUTERLVIV_REGISTRATION=code

# Which predictor serves the public numbers; the variants are in config.py.
#COMMUTERLVIV_VARIANT=profile

# Session cookies get the `__Host-` prefix, which browsers only accept over
# HTTPS. Set this to false only for a plain-HTTP LAN deployment, and know that
# it is what makes the session cookie interceptable.
#COMMUTERLVIV_SECURE_COOKIES=true

# Where Caddy publishes the UI on this machine. The default keeps it on
# loopback for a reverse proxy in front; `0.0.0.0:8080` exposes it directly.
#COMMUTERLVIV_BIND=127.0.0.1:8080

# The journey planner needs a footpath graph from Overpass, about 5 MB, fetched
# once onto the volume the first time the service comes up without one. Set
# this to false to keep the deployment off external APIs entirely, and copy
# data/walk.npz and data/transfers.npz in by hand instead - `/api/plan` answers
# 503 until they are there.
#COMMUTERLVIV_BUILD_PLANNER=true

# Where searching for an address or a place asks. The default is Photon's public
# instance, which asks that anyone leaning on it run their own - a self-hosted
# one goes here. Empty leaves the local index alone, which has no house numbers.
#COMMUTERLVIV_PHOTON_URL=https://photon.komoot.io

# Where the local place index (data/lviv-search.sqlite) is downloaded from: on
# the first start, then every 30 days. This repository's CI rebuilds it monthly
# from OpenStreetMap. Empty never downloads it; one copied into the volume is used
# as it is. With neither source, search falls back to stop names.
#COMMUTERLVIV_PLACES_URL=https://github.com/rhusiev/CommuterLviv/releases/download/places/lviv-search.sqlite

# The basemap is cut for Lviv and served from this stack by the `tiles`
# container. False points the clients at tiles.versatiles.org instead, which
# then sees every visitor's address and where they look; stop the container too
# with `docker compose up -d --scale tiles=0`.
#COMMUTERLVIV_SELF_TILES=true

# Where the tiles container keeps the extract and styles, about 110 MB. A named
# volume unless this is a path.
#COMMUTERLVIV_TILES=/opt/commuterlviv/tiles

# Which overlay every `docker compose` command adds, read by Compose itself so
# no command needs `-f`. Unset, Caddy is published on 127.0.0.1:8080 for TLS
# terminated in front of it; the tls overlay has Caddy take 80 and 443 and get
# the certificate, the proxy overlay puts it on a running proxy's network.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Only with docker-compose.tls.yml: the domain Caddy gets a certificate for.
#COMMUTERLVIV_SITE_ADDRESS=commuterlviv.r1a.nl

# Only with docker-compose.proxy.yml: the name of the docker network the proxy
# you already run is on. The stack publishes no port in that mode; the proxy
# reaches the web container by name, `reverse_proxy commuterlviv_web:8080`.
#CADDY_NETWORK=caddy
